# Copy to .env and fill in. Never commit the real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required. The app fails loudly at startup without it.
DATABASE_URL=postgresql+asyncpg://understudy:understudy@localhost:5432/understudy

# Required only to run the test suite (pytest). Must point at a different database than
# DATABASE_URL above — the suite refuses to run if they match, so it can never accidentally
# roll back against the real one. `make test` starts postgres-test on port 5433 for this.
TEST_DATABASE_URL=postgresql+asyncpg://understudy:understudy@localhost:5433/understudy_test

# Optional. Server-side only — never exposed to /web. Absence degrades capability
# instead of crashing; see GET /healthz.
HUNAR_API_KEY=
NVIDIA_API_KEY=
PDL_API_KEY=
CORESIGNAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Comma-separated E.164 numbers allowed to receive outbound demo calls
# regardless of consent_recorded_at.
DEMO_ALLOWED_NUMBERS=

# Comma-separated origins allowed to call this API. Defaults to the local Next.js dev server;
# production sets this to the deployed Vercel URL (see render.yaml).
CORS_ORIGINS=http://localhost:3000

# Candidate sourcing provider: pdl | coresignal | fixtures. Falls back to fixtures at call time
# on an auth or quota error from the configured provider, regardless of this setting.
SOURCING_PROVIDER=coresignal

# Consent channel: manual | whatsapp. WhatsApp is a documented seam only (raises
# NotImplementedError) — see app/integrations/whatsapp/channel.py.
CHANNEL=manual

# Run app/worker.py's poll loop as a background task inside this process instead of a separate
# `python -m app.worker` service — only for a platform that can't run a second service at all
# (see render.yaml). Leave false locally: docker-compose already runs a dedicated worker
# container, and running both would just have them race harmlessly for the same jobs.
RUN_WORKER_INLINE=false

# Publicly reachable base URL for this service, used to build Hunar's four callback_config
# URLs (call_status/recording/result/summary_callback_url). Optional: left unset, calls are
# placed without callback_config and app/services/outreach.refresh_outreach's polling keeps
# the board correct without webhooks — see docs/channel-strategy.md for the wider rationale.
PUBLIC_BASE_URL=

# Per-role LLM routing: LLM_PROVIDER_<ROLE> / LLM_MODEL_<ROLE>, with an optional fallback used
# when the primary is out of quota or failing. Roles are compiler | simulator. Providers are
# nvidia | gemini | groq. Defaults below match app/core/settings.py — only set these to override.
# LLM_PROVIDER_COMPILER=nvidia
# LLM_MODEL_COMPILER=nvidia/llama-3.1-nemotron-70b-instruct
# LLM_FALLBACK_PROVIDER_COMPILER=groq
# LLM_FALLBACK_MODEL_COMPILER=openai/gpt-oss-120b
# LLM_PROVIDER_SIMULATOR=nvidia
# LLM_MODEL_SIMULATOR=nvidia/llama-3.1-nemotron-70b-instruct
# LLM_FALLBACK_PROVIDER_SIMULATOR=groq
# LLM_FALLBACK_MODEL_SIMULATOR=openai/gpt-oss-120b
# LLM_CACHE_ENABLED=true
