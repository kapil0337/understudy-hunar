{"openapi":"3.1.0","info":{"title":"Understudy","description":"Rehearse-then-dial voice recruiting on the Hunar Voice Agents API.","version":"0.1.0"},"paths":{"/healthz":{"get":{"tags":["health"],"summary":"Liveness and capability probe","description":"Liveness/capability probe. Reports which optional integrations are configured\nso a reviewer running with only a database can see what's degraded and why.","operationId":"healthz_healthz_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Healthz Healthz Get"}}}}}}},"/guardrails":{"get":{"tags":["jobs"],"summary":"The calling window and retry policy every published agent uses","description":"One fixed, org-wide policy (app/services/guardrails.py) — sent explicitly on every publish rather than left to Hunar's org defaults, precisely so it can be read back here instead of being opaque.","operationId":"get_guardrails_guardrails_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GuardrailsRead"}}}}}}},"/jobs":{"get":{"tags":["jobs"],"summary":"List jobs","operationId":"list_jobs_jobs_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/JobRead"},"type":"array","title":"Response List Jobs Jobs Get"}}}}}},"post":{"tags":["jobs"],"summary":"Create a job","description":"Stores the raw job description. Nothing is compiled yet — PUT /jobs/{id}/requirements does that.","operationId":"create_job_jobs_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}":{"get":{"tags":["jobs"],"summary":"Get one job","operationId":"get_job_jobs__job_id__get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["jobs"],"summary":"Delete a job","description":"Permanently deletes the job and everything scoped to it — candidates, outreach/call history, agent versions, rehearsal runs and cases, and proposed patches. Irreversible.","operationId":"delete_job_jobs__job_id__delete","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/requirements":{"put":{"tags":["jobs"],"summary":"Update a job's requirements","description":"Recompiles the raw JD and creates a new draft AgentVersion (origin=COMPILED, unpublished) for every language the compiled JD implies. Never edits an existing version — versions are immutable (CLAUDE.md). Compiling is an LLM call, so this returns immediately with a job id; poll GET /background-jobs/{id}, then GET /jobs/{id}/versions once COMPLETED.","operationId":"update_requirements_jobs__job_id__requirements_put","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RequirementsUpdate"}}}},"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RequirementsUpdateAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/versions":{"get":{"tags":["jobs"],"summary":"Version history with composite score per version","operationId":"list_versions_jobs__job_id__versions_get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/VersionHistoryRow"},"title":"Response List Versions Jobs  Job Id  Versions Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/versions/{version_no}/publish":{"post":{"tags":["jobs"],"summary":"Publish a draft version to Hunar","description":"`language` disambiguates: versions are numbered per (job, language), so version_no alone is not unique across languages.","operationId":"publish_job_version_jobs__job_id__versions__version_no__publish_post","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}},{"name":"version_no","in":"path","required":true,"schema":{"type":"integer","title":"Version No"}},{"name":"language","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Language"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VersionSummary"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/personas":{"get":{"tags":["jobs"],"summary":"The six rehearsal personas","description":"Returns the generated personas, or 202 + a job id on the first call for a job (generating them is an LLM call, deferred to app/worker.py) — poll GET /background-jobs/{id} then re-GET this same endpoint once COMPLETED.","operationId":"list_personas_jobs__job_id__personas_get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"type":"array","items":{"$ref":"#/components/schemas/PersonaRead"}},{"$ref":"#/components/schemas/PersonaGenerationAccepted"}],"title":"Response List Personas Jobs  Job Id  Personas Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/source":{"post":{"tags":["jobs"],"summary":"Source candidates","description":"Every field falls back to the job's own compiled search_query when omitted, so re-sourcing more of the same needs no body at all.","operationId":"source_candidates_jobs__job_id__source_post","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SourceRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SourceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/candidates":{"get":{"tags":["jobs"],"summary":"List candidates, best match first","operationId":"list_candidates_jobs__job_id__candidates_get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CandidateRead"},"title":"Response List Candidates Jobs  Job Id  Candidates Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/call":{"post":{"tags":["jobs"],"summary":"Launch outbound screening calls","description":"Blocked candidates are returned WITH reasons, never silently skipped — the consent/DNC guard is unbypassable (CLAUDE.md).","operationId":"launch_calls_jobs__job_id__call_post","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CallRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CallLaunchSummary"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/board":{"get":{"tags":["jobs"],"summary":"The live candidate/call board","description":"Refreshes non-terminal outreach rows on read (polling), then reads whatever state is current — the board is correct even if Hunar's webhooks never arrive.","operationId":"get_board_jobs__job_id__board_get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BoardResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}/export":{"get":{"tags":["jobs"],"summary":"Export candidates as CSV","description":"One row per candidate, one column per screening question id plus the four standard result fields, pulled from each candidate's latest call result.","operationId":"export_candidates_jobs__job_id__export_get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/versions/{version_id}":{"get":{"tags":["rehearsal"],"summary":"One agent version's full built prompt and result schema","operationId":"get_version_versions__version_id__get","parameters":[{"name":"version_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Version Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AgentVersionRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/versions/{version_id}/rehearse":{"post":{"tags":["rehearsal"],"summary":"Rehearse an agent version","description":"Runs all six personas against this version and scores the result. Returns immediately with a run id in PENDING status; poll GET /runs/{id} for progress.","operationId":"rehearse_version_versions__version_id__rehearse_post","parameters":[{"name":"version_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Version Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RehearseAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/versions/{version_id}/latest-run":{"get":{"tags":["rehearsal"],"summary":"This version's most recent rehearsal run, if it has one","description":"null if the version has never been rehearsed — a valid state, not an error, so this returns 200 rather than 404.","operationId":"get_latest_run_versions__version_id__latest_run_get","parameters":[{"name":"version_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Version Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/RunRead"},{"type":"null"}],"title":"Response Get Latest Run Versions  Version Id  Latest Run Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/runs/{run_id}":{"get":{"tags":["rehearsal"],"summary":"A rehearsal run's status, scores, and per-case summaries","operationId":"get_run_runs__run_id__get","parameters":[{"name":"run_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Run Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/runs/{run_id}/cases/{case_id}":{"get":{"tags":["rehearsal"],"summary":"One persona's full transcript, extraction, ground truth, metrics and failures","operationId":"get_case_runs__run_id__cases__case_id__get","parameters":[{"name":"run_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Run Id"}},{"name":"case_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Case Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CaseRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/runs/{run_id}/patch":{"post":{"tags":["rehearsal"],"summary":"Propose a prompt patch addressing this run's worst failures","description":"Proposing a patch is an LLM call, so this returns immediately with a job id; poll GET /background-jobs/{id}, then GET /patches/{id} (result.patch_id) once COMPLETED.","operationId":"propose_run_patch_runs__run_id__patch_post","parameters":[{"name":"run_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Run Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatchProposalAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/patches/{patch_id}":{"get":{"tags":["rehearsal"],"summary":"One proposed patch","description":"Fetch a patch proposed by POST /runs/{id}/patch — that endpoint returns 202 immediately since proposing a patch is an LLM call; poll GET /background-jobs/{id} then fetch it here once COMPLETED.","operationId":"get_patch_patches__patch_id__get","parameters":[{"name":"patch_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Patch Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatchRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/patches/{patch_id}/accept":{"post":{"tags":["rehearsal"],"summary":"Accept a proposed patch","description":"Creates AgentVersion n+1 (origin=PATCHED) from the patch's prompt immediately, then enqueues rehearsing it against the same personas as the parent run — a patch's effect is measured, never assumed. Poll GET /versions/{version.id}/latest-run for the rehearsal.","operationId":"accept_run_patch_patches__patch_id__accept_post","parameters":[{"name":"patch_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Patch Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatchAcceptAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/candidates/{candidate_id}":{"patch":{"tags":["candidates"],"summary":"Update a candidate's phone, language, or DNC flag","description":"A plain field edit — unlike POST .../consent, this never sets consent_recorded_at. The outbound-call guard still checks consent independently at call time regardless of what phone_e164 is set to here.","operationId":"patch_candidate_candidates__candidate_id__patch","parameters":[{"name":"candidate_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Candidate Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CandidatePatch"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CandidateRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/candidates/{candidate_id}/consent":{"post":{"tags":["candidates"],"summary":"Record consent","description":"Sets phone_e164 and consent_recorded_at together — the only route that does, per CLAUDE.md's rule that a call needs an explicitly consented number.","operationId":"record_candidate_consent_candidates__candidate_id__consent_post","parameters":[{"name":"candidate_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Candidate Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConsentCreate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CandidateRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/webhooks/hunar/{kind}":{"post":{"tags":["webhooks"],"summary":"Receive a Hunar call-lifecycle webhook","description":"`kind` is one of status|recording|result|summary. The signature is carried in the `X-Hunar-Signature` header, timed by `X-Hunar-Timestamp` (confirmed header names), and verified over the RAW request body (see app/integrations/hunar/signature.py). A request missing either header returns 400 naming the missing one; a present-but-wrong signature returns 401 and is never applied. An unrecognised call/request id is still accepted (200) and logged rather than erroring, since Hunar would otherwise retry a payload it has no way to fix.","operationId":"receive_hunar_webhook_webhooks_hunar__kind__post","parameters":[{"name":"kind","in":"path","required":true,"schema":{"enum":["status","recording","result","summary"],"type":"string","title":"Kind"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Response Receive Hunar Webhook Webhooks Hunar  Kind  Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/debug/webhooks":{"get":{"tags":["debug"],"summary":"Recent raw webhook events, valid or not","description":"The append-only log every inbound Hunar webhook is recorded to, regardless of whether its signature verified or it resolved to a known call — see WebhookEvent's docstring. Diagnostic only.","operationId":"list_webhook_events_debug_webhooks_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/WebhookEventRead"},"title":"Response List Webhook Events Debug Webhooks Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/background-jobs/{background_job_id}":{"get":{"tags":["jobs"],"summary":"Status of a deferred LLM-heavy operation","description":"The one poll target shared by every operation the API defers to app/worker.py (compile_jd, regenerate_personas, propose_patch, rehearse) — PENDING/RUNNING/COMPLETED/FAILED, same convention as RehearsalRun.status.","operationId":"get_background_job_background_jobs__background_job_id__get","parameters":[{"name":"background_job_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Background Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BackgroundJobRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"AgentVersionOrigin":{"type":"string","enum":["COMPILED","PATCHED"],"title":"AgentVersionOrigin"},"AgentVersionRead":{"properties":{"id":{"type":"string","format":"uuid","title":"Id"},"job_id":{"type":"string","format":"uuid","title":"Job Id"},"version_no":{"type":"integer","title":"Version No"},"language":{"$ref":"#/components/schemas/Language"},"origin":{"$ref":"#/components/schemas/AgentVersionOrigin"},"voice_persona":{"$ref":"#/components/schemas/VoicePersona"},"persona_name":{"type":"string","title":"Persona Name"},"agent_prompt":{"type":"string","title":"Agent Prompt"},"objective":{"type":"string","title":"Objective"},"introduction":{"type":"string","title":"Introduction"},"result_prompt":{"type":"string","title":"Result Prompt"},"result_schema":{"additionalProperties":true,"type":"object","title":"Result Schema"},"hunar_agent_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Hunar Agent Id"},"created_at":{"type":"string","format":"date-time","title":"Created At"}},"additionalProperties":false,"type":"object","required":["id","jo